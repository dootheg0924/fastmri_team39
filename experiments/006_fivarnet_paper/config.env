# Final FI-VarNet configuration from the paper-linked fastMRI implementation.
#
# This is the paper's 93.8M-parameter size-matched model: 6 feature cascades
# followed by 6 image cascades. The atomic --training-preset also fixes AdamW,
# the exp/003 foreground+bbox SSIM loss, the 210k-step LR schedule, clipping,
# seed, and GTX 1080 checkpointing; the explicit values below keep the
# resolved manifest and smoke-test architecture identical.

: "${EXP_NAME:=final_fivarnet_f6i6_ch32_s8_bw05_gtx1080_210k}"
: "${DATA_ROOT:=/root/Data}"
: "${RESULT_ROOT:=${REPO_ROOT}/../result}"
: "${CUDA_VISIBLE_DEVICES:=0}"
: "${TORCH_GPU_NUM:=0}"

: "${TRAINING_PRESET:=fi-varnet-paper}"
: "${BATCH_SIZE:=1}"
: "${NUM_EPOCHS:=1}"              # ignored by the preset's 210k-step stop
: "${LEARNING_RATE:=3e-4}"
: "${REPORT_INTERVAL:=50}"
: "${SEED:=42}"

: "${MODEL_NAME:=fivarnet}"
: "${CASCADES:=6}"                # feature-space cascades
: "${IMAGE_CASCADES:=6}"          # image-space cascades
: "${CHANS:=32}"
: "${SENS_CHANS:=8}"
: "${POOLS:=4}"
: "${SENS_POOLS:=4}"
: "${ATTENTION_CASCADES:=0 1 2 3 4 5}"
: "${FEATURE_PROCESSOR:=paper-unet2d}"
: "${NO_GRAD_CHECKPOINT:=0}"      # enable cascade checkpointing for 8 GB VRAM
: "${KSPACE_MULT_FACTOR:=1e6}"
: "${GRADIENT_ACCUMULATION_STEPS:=4}" # physical 1; effective 4 as in 4-GPU paper run
: "${DATA_SAMPLER_SEED:=0}"       # torch DistributedSampler default
: "${COMBINE_TRAIN_VAL:=0}"       # knee protocol; brain leaderboard runner used 1
: "${CHECKPOINT_METRIC:=paper-final}" # knee paper skips val; final 210k model wins
: "${DETERMINISTIC:=0}"           # reference left PL deterministic mode disabled
: "${FLOAT32_MATMUL_PRECISION:=high}"
: "${BBOX_LOSS_WEIGHT:=0.5}"      # L_full + 0.5 * L_bbox, from exp/003
: "${ACC_FILM:=0}"
: "${SPLIT_ATTENTION_CASCADES:=}"
: "${BALANCE_ACCELERATIONS:=0}"

: "${NUM_WORKERS:=4}"
: "${PIN_MEMORY:=0}"              # reference DataLoader default
: "${CHECKPOINT_INTERVAL:=0}"     # a single checkpoint is already very large
: "${GPU_SAMPLE_INTERVAL:=60}"
: "${RUN_SMOKE_TEST:=1}"
: "${RUN_VALIDATION_ANALYSIS:=1}"

export EXP_NAME DATA_ROOT RESULT_ROOT CUDA_VISIBLE_DEVICES TORCH_GPU_NUM
export TRAINING_PRESET BATCH_SIZE NUM_EPOCHS LEARNING_RATE REPORT_INTERVAL SEED
export MODEL_NAME CASCADES IMAGE_CASCADES CHANS SENS_CHANS POOLS SENS_POOLS
export ATTENTION_CASCADES FEATURE_PROCESSOR NO_GRAD_CHECKPOINT KSPACE_MULT_FACTOR BBOX_LOSS_WEIGHT
export GRADIENT_ACCUMULATION_STEPS DATA_SAMPLER_SEED COMBINE_TRAIN_VAL
export CHECKPOINT_METRIC DETERMINISTIC FLOAT32_MATMUL_PRECISION
export ACC_FILM SPLIT_ATTENTION_CASCADES BALANCE_ACCELERATIONS
export NUM_WORKERS PIN_MEMORY CHECKPOINT_INTERVAL GPU_SAMPLE_INTERVAL
export RUN_SMOKE_TEST RUN_VALIDATION_ANALYSIS
