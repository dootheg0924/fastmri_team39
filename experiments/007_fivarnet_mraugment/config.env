# FI-VarNet 6+6 final training with paper-aligned MRAugment.
#
# The final profile attempts at most 100 epochs and can resolve a smaller,
# safely completable target from the first measured epoch. It retains the
# FI-VarNet optimizer's relative LR phases, physical batch 1, effective batch
# 4, and the full+bbox SSIM objective without a fixed-step stop.

: "${EXP_NAME:=final_fivarnet_submission_f6i6_mraugment_all_data}"
: "${DATA_ROOT:=/root/Data}"
: "${RESULT_ROOT:=${REPO_ROOT}/../result}"
: "${CUDA_VISIBLE_DEVICES:=0}"
: "${TORCH_GPU_NUM:=0}"

: "${TRAINING_PRESET:=fi-varnet-final}"
: "${BATCH_SIZE:=1}"
: "${NUM_EPOCHS:=100}"
: "${LEARNING_RATE:=3e-4}"
: "${REPORT_INTERVAL:=50}"
: "${SEED:=42}"

: "${MODEL_NAME:=fivarnet}"
: "${CASCADES:=6}"
: "${IMAGE_CASCADES:=6}"
: "${CHANS:=32}"
: "${SENS_CHANS:=8}"
: "${POOLS:=4}"
: "${SENS_POOLS:=4}"
: "${ATTENTION_CASCADES:=0 1 2 3 4 5}"
: "${FEATURE_PROCESSOR:=paper-unet2d}"
: "${NO_GRAD_CHECKPOINT:=0}"
: "${KSPACE_MULT_FACTOR:=1e6}"
: "${GRADIENT_ACCUMULATION_STEPS:=4}"
: "${DATA_SAMPLER_SEED:=0}"
: "${COMBINE_TRAIN_VAL:=1}"
: "${CHECKPOINT_METRIC:=submission-latest}"
: "${DETERMINISTIC:=0}"
: "${FLOAT32_MATMUL_PRECISION:=high}"
: "${BBOX_LOSS_WEIGHT:=0.5}"
: "${ACC_FILM:=0}"
: "${SPLIT_ATTENTION_CASCADES:=}"
: "${BALANCE_ACCELERATIONS:=0}"

# Fabian et al. fastMRI schedule: p(t) rises exponentially from 0 to 0.55
# with normalized coefficient c=5 and no delay.
: "${MRAUGMENT:=1}"
: "${MRAUGMENT_SCHEDULE:=exp}"
: "${MRAUGMENT_STRENGTH:=0.55}"
: "${MRAUGMENT_EXP_DECAY:=5.0}"
: "${MRAUGMENT_DELAY_EPOCHS:=0}"
: "${MRAUGMENT_SEED:=42}"
: "${MRAUGMENT_MIN_BBOX_SIZE:=7}"

# Set this to the actual GPU allocation window (for example 48). After the
# first complete epoch, the runner resolves a safe target epoch and retunes
# both LR and MRAugment schedules. Empty means use NUM_EPOCHS=100 directly.
: "${TRAINING_TIME_BUDGET_HOURS:=}"
: "${TRAINING_TIME_RESERVE_FRACTION:=0.15}"
: "${TRAINING_TIME_PROBE_EPOCHS:=2}"

: "${NUM_WORKERS:=4}"
: "${PIN_MEMORY:=0}"
: "${CHECKPOINT_INTERVAL:=0}"
: "${GPU_SAMPLE_INTERVAL:=60}"
: "${RUN_SMOKE_TEST:=1}"
: "${RUN_VALIDATION_ANALYSIS:=0}" # validation labels are part of final training

export EXP_NAME DATA_ROOT RESULT_ROOT CUDA_VISIBLE_DEVICES TORCH_GPU_NUM
export TRAINING_PRESET BATCH_SIZE NUM_EPOCHS LEARNING_RATE REPORT_INTERVAL SEED
export MODEL_NAME CASCADES IMAGE_CASCADES CHANS SENS_CHANS POOLS SENS_POOLS
export ATTENTION_CASCADES FEATURE_PROCESSOR NO_GRAD_CHECKPOINT KSPACE_MULT_FACTOR
export GRADIENT_ACCUMULATION_STEPS DATA_SAMPLER_SEED COMBINE_TRAIN_VAL
export CHECKPOINT_METRIC DETERMINISTIC FLOAT32_MATMUL_PRECISION BBOX_LOSS_WEIGHT
export ACC_FILM SPLIT_ATTENTION_CASCADES BALANCE_ACCELERATIONS
export MRAUGMENT MRAUGMENT_SCHEDULE MRAUGMENT_STRENGTH MRAUGMENT_EXP_DECAY
export MRAUGMENT_DELAY_EPOCHS MRAUGMENT_SEED MRAUGMENT_MIN_BBOX_SIZE
export TRAINING_TIME_BUDGET_HOURS TRAINING_TIME_RESERVE_FRACTION
export TRAINING_TIME_PROBE_EPOCHS
export NUM_WORKERS PIN_MEMORY CHECKPOINT_INTERVAL GPU_SAMPLE_INTERVAL
export RUN_SMOKE_TEST RUN_VALIDATION_ANALYSIS
