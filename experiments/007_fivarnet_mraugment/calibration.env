# Two-epoch throughput calibration for the final FI-VarNet run.
#
# Epoch 0 uses p=0 and epoch 1 uses p~=0.51, so the second epoch measures
# near-final MRAugment CPU cost. This checkpoint is not a submission warm start.

CALIBRATION_CONFIG_DIR="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd
)"

: "${CALIBRATION_EXP_NAME:=calibrate_fivarnet_f6i6_mraugment_all_data}"
EXP_NAME="${CALIBRATION_EXP_NAME}"
FINAL_NUM_EPOCHS=2
NUM_EPOCHS=2
TRAINING_TIME_BUDGET_HOURS=
CHECKPOINT_METRIC=submission-latest
RUN_VALIDATION_ANALYSIS=0

# shellcheck source=config.env
source "${CALIBRATION_CONFIG_DIR}/config.env"

export EXP_NAME FINAL_NUM_EPOCHS NUM_EPOCHS TRAINING_TIME_BUDGET_HOURS
export CHECKPOINT_METRIC RUN_VALIDATION_ANALYSIS
