# Canonical configuration for experiment 003 (FI-VarNet + bbox-aware loss).
# Existing environment variables take precedence, so a local GTX 1080 run or a
# VESSL job can override paths or runtime-only settings without editing the
# tracked experiment config.
#
# 8GB VRAM ladder if the smoke test OOMs (apply in order):
#   SENS_CHANS down -> ATTENTION_CASCADES smaller -> CHANS down -> CASCADES down.

: "${EXP_NAME:=fivarnet_f4i2_ch12_s4_att01_bw1_lr3e4}"
: "${DATA_ROOT:=/root/Data}"
: "${RESULT_ROOT:=${REPO_ROOT}/../result}"
: "${CUDA_VISIBLE_DEVICES:=0}"
: "${TORCH_GPU_NUM:=0}"

: "${BATCH_SIZE:=1}"
: "${NUM_EPOCHS:=80}"
: "${LEARNING_RATE:=3e-4}"
: "${REPORT_INTERVAL:=50}"
: "${SEED:=430}"

: "${MODEL_NAME:=fivarnet}"
: "${CASCADES:=4}"              # feature-space cascades
: "${IMAGE_CASCADES:=2}"        # image-space cascades after the feature path
: "${CHANS:=12}"
: "${SENS_CHANS:=4}"
: "${POOLS:=4}"
: "${SENS_POOLS:=4}"
: "${ATTENTION_CASCADES:=0 1}"  # feature-cascade indices with aliasing attention
: "${KSPACE_MULT_FACTOR:=1e6}"
: "${BBOX_LOSS_WEIGHT:=1.0}"    # 0 = pure foreground SSIM (FIVarNet-only ablation)

: "${NUM_WORKERS:=4}"
: "${PIN_MEMORY:=1}"
: "${CHECKPOINT_INTERVAL:=10}"
: "${GPU_SAMPLE_INTERVAL:=60}"
: "${RUN_SMOKE_TEST:=1}"
: "${RUN_VALIDATION_ANALYSIS:=1}"

export EXP_NAME DATA_ROOT RESULT_ROOT CUDA_VISIBLE_DEVICES TORCH_GPU_NUM
export BATCH_SIZE NUM_EPOCHS LEARNING_RATE REPORT_INTERVAL SEED
export MODEL_NAME CASCADES IMAGE_CASCADES CHANS SENS_CHANS POOLS SENS_POOLS
export ATTENTION_CASCADES KSPACE_MULT_FACTOR BBOX_LOSS_WEIGHT
export NUM_WORKERS PIN_MEMORY CHECKPOINT_INTERVAL GPU_SAMPLE_INTERVAL
export RUN_SMOKE_TEST RUN_VALIDATION_ANALYSIS
