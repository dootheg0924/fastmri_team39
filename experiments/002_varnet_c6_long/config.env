# Canonical configuration for experiment 002.
# Existing environment variables take precedence, so VESSL jobs can override
# paths or runtime-only settings without editing the tracked experiment config.

: "${EXP_NAME:=varnet_c6_ch12_s4_ep80_lr3e4}"
: "${DATA_ROOT:=/root/Data}"
: "${RESULT_ROOT:=${REPO_ROOT}/../result}"
: "${CUDA_VISIBLE_DEVICES:=0}"
: "${TORCH_GPU_NUM:=0}"

: "${BATCH_SIZE:=1}"
: "${NUM_EPOCHS:=80}"
: "${LEARNING_RATE:=3e-4}"
: "${REPORT_INTERVAL:=50}"
: "${SEED:=430}"

: "${CASCADES:=6}"
: "${CHANS:=12}"
: "${SENS_CHANS:=4}"

: "${NUM_WORKERS:=4}"
: "${PIN_MEMORY:=1}"
: "${CHECKPOINT_INTERVAL:=10}"
: "${GPU_SAMPLE_INTERVAL:=60}"
: "${RUN_SMOKE_TEST:=1}"
: "${RUN_VALIDATION_ANALYSIS:=1}"

export EXP_NAME DATA_ROOT RESULT_ROOT CUDA_VISIBLE_DEVICES TORCH_GPU_NUM
export BATCH_SIZE NUM_EPOCHS LEARNING_RATE REPORT_INTERVAL SEED
export CASCADES CHANS SENS_CHANS NUM_WORKERS PIN_MEMORY
export CHECKPOINT_INTERVAL GPU_SAMPLE_INTERVAL RUN_VALIDATION_ANALYSIS
export RUN_SMOKE_TEST
