# FI-VarNet 6+6 final training, continued with cross-acceleration re-masking.
#
# Identical to experiments/007_fivarnet_mraugment/config.env except for the two
# CROSS_ACCELERATION settings and EXP_NAME. Every schedule-bearing value is held
# at the 007 figure -- FINAL_NUM_EPOCHS, LEARNING_RATE, SEED, MRAUGMENT_SEED and
# the MRAugment schedule -- so a run resumed from an 007 checkpoint keeps the
# same 100-epoch LR and augmentation horizons and changes only the acquisition
# a volume is presented with.

: "${EXP_NAME:=final_fivarnet_submission_f6i6_mraugment_cross_acc}"
: "${DATA_ROOT:=/root/Data}"
: "${RESULT_ROOT:=${REPO_ROOT}/../result}"
: "${CUDA_VISIBLE_DEVICES:=0}"
: "${TORCH_GPU_NUM:=0}"

: "${TRAINING_PRESET:=fi-varnet-final}"
: "${BATCH_SIZE:=1}"
: "${FINAL_NUM_EPOCHS:=100}"
: "${NUM_EPOCHS:=${FINAL_NUM_EPOCHS}}"
: "${LEARNING_RATE:=3e-4}"
: "${REPORT_INTERVAL:=50}"
: "${SEED:=42}"

: "${MODEL_NAME:=fivarnet}"
: "${CASCADES:=6}"
: "${IMAGE_CASCADES:=6}"
: "${CHANS:=32}"
: "${SENS_CHANS:=8}"
: "${POOLS:=4}"
: "${SENS_POOLS:=4}"
: "${ATTENTION_CASCADES:=0 1 2 3 4 5}"
: "${FEATURE_PROCESSOR:=paper-unet2d}"
: "${NO_GRAD_CHECKPOINT:=0}"
: "${KSPACE_MULT_FACTOR:=1e6}"
: "${GRADIENT_ACCUMULATION_STEPS:=4}"
: "${DATA_SAMPLER_SEED:=0}"
: "${COMBINE_TRAIN_VAL:=1}"
: "${CHECKPOINT_METRIC:=submission-latest}"
: "${DETERMINISTIC:=1}"
: "${FLOAT32_MATMUL_PRECISION:=high}"
: "${CUBLAS_WORKSPACE_CONFIG:=:4096:8}"
: "${PYTHONHASHSEED:=${SEED}}"
: "${BBOX_LOSS_WEIGHT:=0.5}"
: "${ACC_FILM:=0}"
: "${SPLIT_ATTENTION_CASCADES:=}"
: "${BALANCE_ACCELERATIONS:=0}"

# Fabian et al. fastMRI schedule: p(t) rises exponentially from 0 to 0.55
# with normalized coefficient c=5 and no delay.
: "${MRAUGMENT:=1}"
: "${MRAUGMENT_SCHEDULE:=exp}"
: "${MRAUGMENT_STRENGTH:=0.55}"
: "${MRAUGMENT_EXP_DECAY:=5.0}"
: "${MRAUGMENT_DELAY_EPOCHS:=0}"
: "${MRAUGMENT_SEED:=42}"
: "${MRAUGMENT_MIN_BBOX_SIZE:=7}"

# Cross-acceleration re-masking. Every volume-epoch draws its acceleration, so
# both acceleration groups feed the R8 half of training instead of only the
# volumes that happen to ship an R8 mask. 0 restores the 007 behaviour exactly.
: "${CROSS_ACCELERATION:=1.0}"
: "${CROSS_ACCELERATION_P8:=0.5}"

# Stage two starts from the epoch-50 checkpoint of the 007 run, which must
# already be copied to <RESULT_ROOT>/<EXP_NAME>/checkpoints/model.pt (see
# README). The guard fails loudly rather than silently training on from an
# earlier checkpoint; resuming later than 50 after an interruption is allowed
# and only logged.
: "${EXPECTED_RESUME_EPOCH:=50}"

# Standalone snapshots, kept in addition to model.pt and best_model.pt and
# never promoted over them. Late epochs are preserved so the submission can be
# chosen after the fact instead of being fixed by whenever the run stops.
: "${CHECKPOINT_EPOCHS:=80 85 90 95}"

# Keep the generic timing-based horizon resolver disabled. This run always
# schedules 100 epochs and preserves the latest complete epoch if interrupted.
: "${TRAINING_TIME_BUDGET_HOURS:=}"

: "${NUM_WORKERS:=2}"             # allocation exposes two CPU cores
: "${PIN_MEMORY:=1}"              # enables the existing non-blocking GPU copies
: "${CHECKPOINT_INTERVAL:=0}"
: "${GPU_SAMPLE_INTERVAL:=60}"
: "${RUN_SMOKE_TEST:=1}"
: "${RUN_VALIDATION_ANALYSIS:=0}" # validation labels are part of final training

export EXP_NAME DATA_ROOT RESULT_ROOT CUDA_VISIBLE_DEVICES TORCH_GPU_NUM
export TRAINING_PRESET BATCH_SIZE FINAL_NUM_EPOCHS NUM_EPOCHS LEARNING_RATE
export REPORT_INTERVAL SEED
export MODEL_NAME CASCADES IMAGE_CASCADES CHANS SENS_CHANS POOLS SENS_POOLS
export ATTENTION_CASCADES FEATURE_PROCESSOR NO_GRAD_CHECKPOINT KSPACE_MULT_FACTOR
export GRADIENT_ACCUMULATION_STEPS DATA_SAMPLER_SEED COMBINE_TRAIN_VAL
export CHECKPOINT_METRIC DETERMINISTIC FLOAT32_MATMUL_PRECISION BBOX_LOSS_WEIGHT
export CUBLAS_WORKSPACE_CONFIG PYTHONHASHSEED
export ACC_FILM SPLIT_ATTENTION_CASCADES BALANCE_ACCELERATIONS
export MRAUGMENT MRAUGMENT_SCHEDULE MRAUGMENT_STRENGTH MRAUGMENT_EXP_DECAY
export MRAUGMENT_DELAY_EPOCHS MRAUGMENT_SEED MRAUGMENT_MIN_BBOX_SIZE
export CROSS_ACCELERATION CROSS_ACCELERATION_P8
export EXPECTED_RESUME_EPOCH CHECKPOINT_EPOCHS
export TRAINING_TIME_BUDGET_HOURS
export NUM_WORKERS PIN_MEMORY CHECKPOINT_INTERVAL GPU_SAMPLE_INTERVAL
export RUN_SMOKE_TEST RUN_VALIDATION_ANALYSIS
