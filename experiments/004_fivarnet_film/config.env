# Canonical configuration for experiment 004 (FI-VarNet + bbox loss + acc-FiLM,
# validate() aligned to the competition metric).
#
# Same architecture as the exp/003 training run (f4/i2/ch12/s4, attention 0 1)
# with BBOX_LOSS_WEIGHT=0.5 matching what exp/003 actually trained with (the
# 003 config default 1.0 was overridden at launch), epochs extended to 100,
# and ACC_FILM=1 turning on acceleration-conditioned FiLM (identity at init).
#
# To instead base the run on the server's f6i6 model, override at launch:
#   CASCADES=6 IMAGE_CASCADES=6 CHANS=18 SENS_CHANS=8 \
#   ATTENTION_CASCADES="0 1 2 3 4 5" EXP_NAME=fivarnet_f6i6_ch18_s8_attall_bw05_film \
#   CONFIG_FILE=experiments/004_fivarnet_film/config.env bash scripts/run_fivarnet_bbox.sh

: "${EXP_NAME:=fivarnet_f4i2_ch12_s4_att01_bw05_film_lr3e4}"
: "${DATA_ROOT:=/root/Data}"
: "${RESULT_ROOT:=${REPO_ROOT}/../result}"
: "${CUDA_VISIBLE_DEVICES:=0}"
: "${TORCH_GPU_NUM:=0}"

: "${BATCH_SIZE:=1}"
: "${NUM_EPOCHS:=100}"
: "${LEARNING_RATE:=3e-4}"
: "${REPORT_INTERVAL:=50}"
: "${SEED:=430}"

: "${MODEL_NAME:=fivarnet}"
: "${CASCADES:=4}"              # feature-space cascades
: "${IMAGE_CASCADES:=2}"        # image-space cascades after the feature path
: "${CHANS:=12}"
: "${SENS_CHANS:=4}"
: "${POOLS:=4}"
: "${SENS_POOLS:=4}"
: "${ATTENTION_CASCADES:=0 1}"  # feature-cascade indices with aliasing attention
: "${KSPACE_MULT_FACTOR:=1e6}"
: "${BBOX_LOSS_WEIGHT:=0.5}"    # exp/003 trained value (repo 003 default 1.0 was overridden)
: "${ACC_FILM:=1}"              # acceleration-conditioned FiLM (identity at init)

: "${NUM_WORKERS:=4}"
: "${PIN_MEMORY:=1}"
: "${CHECKPOINT_INTERVAL:=10}"
: "${GPU_SAMPLE_INTERVAL:=60}"
: "${RUN_SMOKE_TEST:=1}"
: "${RUN_VALIDATION_ANALYSIS:=1}"

export EXP_NAME DATA_ROOT RESULT_ROOT CUDA_VISIBLE_DEVICES TORCH_GPU_NUM
export BATCH_SIZE NUM_EPOCHS LEARNING_RATE REPORT_INTERVAL SEED
export MODEL_NAME CASCADES IMAGE_CASCADES CHANS SENS_CHANS POOLS SENS_POOLS
export ATTENTION_CASCADES KSPACE_MULT_FACTOR BBOX_LOSS_WEIGHT ACC_FILM
export NUM_WORKERS PIN_MEMORY CHECKPOINT_INTERVAL GPU_SAMPLE_INTERVAL
export RUN_SMOKE_TEST RUN_VALIDATION_ANALYSIS
