# Epoch-40 -> epoch-80 continuation with an acc4/acc8 split in F5 attention.
#
# The source checkpoint is mandatory and remains immutable. Its stored
# architecture/loss arguments override the matching values below, so the
# continuation always reconstructs the actual trained f6/i6/ch18 model.
#
# Example:
#   WARM_START_CHECKPOINT=/root/result/<exp003>/checkpoints/model.pt \
#   CONFIG_FILE=experiments/005_f5_attention_split/config.env \
#   bash scripts/run_fivarnet_bbox.sh

: "${WARM_START_CHECKPOINT:?Set WARM_START_CHECKPOINT to the epoch-40 model.pt}"

: "${EXP_NAME:=fivarnet_f6i6_ch18_s8_attall_bw05_f5att_split_e40to80}"
: "${DATA_ROOT:=/root/Data}"
: "${RESULT_ROOT:=${REPO_ROOT}/../result}"
: "${CUDA_VISIBLE_DEVICES:=0}"
: "${TORCH_GPU_NUM:=0}"

: "${BATCH_SIZE:=1}"
: "${NUM_EPOCHS:=80}"             # absolute target, also used after split-run resume
: "${EXPECTED_WARM_START_EPOCH:=40}"
: "${ADDITIONAL_EPOCHS:=40}"
: "${LEARNING_RATE:=3e-4}"        # source Adam learning rate is preserved at migration
: "${REPORT_INTERVAL:=50}"
: "${SEED:=430}"

: "${MODEL_NAME:=fivarnet}"
: "${CASCADES:=6}"
: "${IMAGE_CASCADES:=6}"
: "${CHANS:=18}"
: "${SENS_CHANS:=8}"
: "${POOLS:=4}"
: "${SENS_POOLS:=4}"
: "${ATTENTION_CASCADES:=0 1 2 3 4 5}"
: "${SPLIT_ATTENTION_CASCADES:=5}"
: "${KSPACE_MULT_FACTOR:=1e6}"
: "${BBOX_LOSS_WEIGHT:=0.5}"
: "${ACC_FILM:=0}"

# Exact 50/50 slice-level routing. Oversampling retains every majority slice
# and cycles through reshuffled minority slices; validation stays untouched.
: "${BALANCE_ACCELERATIONS:=1}"
: "${ACCELERATION_BALANCE_MODE:=oversample}"

: "${NUM_WORKERS:=4}"
: "${PIN_MEMORY:=1}"
: "${CHECKPOINT_INTERVAL:=10}"
: "${GPU_SAMPLE_INTERVAL:=60}"
: "${RUN_SMOKE_TEST:=1}"
: "${RUN_VALIDATION_ANALYSIS:=1}"

export EXP_NAME DATA_ROOT RESULT_ROOT CUDA_VISIBLE_DEVICES TORCH_GPU_NUM
export BATCH_SIZE NUM_EPOCHS EXPECTED_WARM_START_EPOCH ADDITIONAL_EPOCHS
export LEARNING_RATE REPORT_INTERVAL SEED
export MODEL_NAME CASCADES IMAGE_CASCADES CHANS SENS_CHANS POOLS SENS_POOLS
export ATTENTION_CASCADES SPLIT_ATTENTION_CASCADES KSPACE_MULT_FACTOR
export BBOX_LOSS_WEIGHT ACC_FILM
export WARM_START_CHECKPOINT BALANCE_ACCELERATIONS ACCELERATION_BALANCE_MODE
export NUM_WORKERS PIN_MEMORY CHECKPOINT_INTERVAL GPU_SAMPLE_INTERVAL
export RUN_SMOKE_TEST RUN_VALIDATION_ANALYSIS
